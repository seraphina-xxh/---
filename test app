@app.route('/staff_dashboard')
def staff_dashboard():
    conn = get_db()
    with conn.cursor() as cursor:
        # 今日预约列表 (待签到)
        cursor.execute("""
            SELECT a.appoint_id, p.name, p.id_card, d.name as doc_name 
            FROM appointments a
            JOIN patients p ON a.patient_id = p.patient_id
            JOIN schedules s ON a.schedule_id = s.schedule_id
            JOIN doctors d ON s.doctor_id = d.doctor_id
            WHERE a.status = 0 AND s.work_date = CURDATE()
        """)
        today_appts = cursor.fetchall()

        # 待缴费账单
        cursor.execute("""
            SELECT b.bill_id, p.name, b.total_amt, b.pay_status 
