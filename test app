@app.route('/login', methods=['POST'])
def login():
    username = request.form['username']
    password = request.form['password']
    role = request.form['role']
    
    conn = get_db()
    try:
        if role == 'patient':
            with conn.cursor() as cursor:
                cursor.execute("SELECT * FROM patients WHERE id_card=%s AND password=%s", (username, password))
                user = cursor.fetchone()
                if user:
                    session['user'] = {'id': user['patient_id'], 'name': user['name'], 'role': 'patient'}
                    return redirect('/')
        else:
            with conn.cursor() as cursor:
                cursor.execute("SELECT * FROM users WHERE username=%s AND password=%s AND role=%s", (username, password, role))
                user = cursor.fetchone()
                if user:
                    # 获取具体身份ID
                    real_id = user['user_id']
                    name = user['username']
                    if role == 'doctor':
                        cursor.execute("SELECT doctor_id, name FROM doctors WHERE user_id=%s", (user['user_id'],))
                        doc = cursor.fetchone()
                        real_id = doc['doctor_id']
                        name = doc['name']

                    session['user'] = {'id': real_id, 'name': name, 'role': role}
                    return redirect('/')
        flash('登录失败，请检查账号密码')
        return redirect('/')
    finally:
        conn.close()

