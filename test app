# --- 1. 患者模块 (预约功能) ---
@app.route('/patient_dashboard')
def patient_dashboard():
    conn = get_db()
    with conn.cursor() as cursor:
        # 查询未来排班
        cursor.execute("""
            SELECT s.*, d.name as doc_name, dept.dept_name 
            FROM schedules s 
            JOIN doctors d ON s.doctor_id = d.doctor_id 
            JOIN departments dept ON d.dept_id = dept.dept_id
            WHERE s.work_date >= CURDATE() AND s.remaining > 0
            ORDER BY s.work_date
        """)
        schedules = cursor.fetchall()
        
        # 查询我的预约
        cursor.execute("""
            SELECT a.*, d.name as doc_name, s.work_date 
            FROM appointments a 
            JOIN schedules s ON a.schedule_id = s.schedule_id 
            JOIN doctors d ON s.doctor_id = d.doctor_id
            WHERE a.patient_id = %s
        """, (session['user']['id'],))
        my_appts = cursor.fetchall()
    conn.close()
    
    return render_template_string(HTML_TEMPLATE.replace('{% block content %}{% endblock %}', """
        <h3>我的预约</h3>
        <table>
            <tr><th>日期</th><th>医生</th><th>状态</th></tr>
            {% for a in my_appts %}
            <tr>
                <td>{{ a.work_date }}</td>
                <td>{{ a.doc_name }}</td>
                <td>
                    {% if a.status == 0 %}已预约{% elif a.status == 1 %}已完成{% else %}已取消{% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>

        <h3>可预约排班</h3>
        <table>
            <tr><th>科室</th><th>医生</th><th>日期</th><th>时段</th><th>剩余</th><th>操作</th></tr>
            {% for s in schedules %}
            <tr>
                <td>{{ s.dept_name }}</td>
                <td>{{ s.doc_name }}</td>
                <td>{{ s.work_date }}</td>
                <td>{{ '上午' if s.shift_type==1 else '下午' }}</td>
                <td>{{ s.remaining }}</td>
                <td>
                    <form action="/book_appt" method="post">
                        <input type="hidden" name="schedule_id" value="{{ s.schedule_id }}">
                        <button class="btn">预约</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </table>
    """), my_appts=my_appts, schedules=schedules)

@app.route('/book_appt', methods=['POST'])
def book_appt():
    sch_id = request.form['schedule_id']
    pat_id = session['user']['id']
    conn = get_db()
    try:
        with conn.cursor() as cursor:
            # 扣减库存
            rows = cursor.execute("UPDATE schedules SET remaining = remaining - 1 WHERE schedule_id=%s AND remaining > 0", (sch_id,))
            if rows > 0:
                cursor.execute("INSERT INTO appointments (patient_id, schedule_id, est_arrival) VALUES (%s, %s, '09:00')", (pat_id, sch_id))
                conn.commit()
                flash('预约成功！')
            else:
                flash('预约失败：号源已满')
    finally:
        conn.close()
    return redirect('/patient_dashboard')

