@app.route('/check_in/<int:appoint_id>')
def check_in(appoint_id):
    # 将预约转为就诊记录 
    conn = get_db()
    try:
        with conn.cursor() as cursor:
            # 获取预约详情
            cursor.execute("SELECT * FROM appointments a JOIN schedules s ON a.schedule_id=s.schedule_id WHERE appoint_id=%s", (appoint_id,))
            appt = cursor.fetchone()
            
            # 生成排队号
            queue_num = cursor.execute("SELECT * FROM encounters WHERE doctor_id=%s AND visit_status < 3", (appt['doctor_id'],)) + 1
            
            # 插入 Encounter
            cursor.execute("""
                INSERT INTO encounters (patient_id, doctor_id, appoint_id, visit_status, queue_number)
                VALUES (%s, %s, %s, 0, %s)
            """, (appt['patient_id'], appt['doctor_id'], appoint_id, queue_num))
            
            # 更新预约状态
            cursor.execute("UPDATE appointments SET status=1 WHERE appoint_id=%s", (appoint_id,))
            conn.commit()
            flash('签到成功，患者已进入候诊队列')
    finally:
        conn.close()
    return redirect('/staff_dashboard')

@app.route('/pay_bill/<int:bill_id>')
def pay_bill(bill_id):
    conn = get_db()
    try:
        with conn.cursor() as cursor:
            # 更新支付状态
            cursor.execute("UPDATE bills SET pay_status=1, pay_time=NOW() WHERE bill_id=%s", (bill_id,))
            
            # 更新就诊状态为结束 (3)
            cursor.execute("""
                UPDATE encounters e JOIN bills b ON e.encounter_id = b.encounter_id
                SET e.visit_status = 3
                WHERE b.bill_id = %s
            """, (bill_id,))
            conn.commit()
            flash('缴费成功')
    finally:
        conn.close()
    return redirect('/staff_dashboard')

