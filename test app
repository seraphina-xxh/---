@app.route('/start_visit/<int:eid>')
def start_visit(eid):
    conn = get_db()
    with conn.cursor() as cursor:
        cursor.execute("UPDATE encounters SET visit_status=1 WHERE encounter_id=%s", (eid,))
        conn.commit()
    return redirect('/doctor_dashboard')

@app.route('/finish_visit', methods=['POST'])
def finish_visit():
    eid = request.form['encounter_id']
    diag = request.form['diagnosis']
    amt = float(request.form['amount'])
    
    conn = get_db()
    try:
        with conn.cursor() as cursor:
            # 1. 更新诊断
            cursor.execute("UPDATE encounters SET diagnosis=%s, visit_status=2 WHERE encounter_id=%s", (diag, eid))
            # 2. 生成账单
            ins_amt = amt * 0.4 # 模拟医保报销40%
            self_amt = amt - ins_amt
            cursor.execute("""
                INSERT INTO bills (encounter_id, total_amt, insurance_amt, self_pay_amt)
                VALUES (%s, %s, %s, %s)
            """, (eid, amt, ins_amt, self_amt))
            conn.commit()
            flash('诊疗结束，账单已发送至收费处')
    finally:
        conn.close()
    return redirect('/doctor_dashboard')

# --- 4. 管理员模块 (报表) ---
@app.route('/admin_dashboard')
def admin_dashboard():
    conn = get_db()
    with conn.cursor() as cursor:
        # 统计科室收入 
        cursor.execute("""
            SELECT d.dept_name, SUM(b.total_amt) as total
            FROM bills b
            JOIN encounters e ON b.encounter_id = e.encounter_id
            JOIN doctors doc ON e.doctor_id = doc.doctor_id
            JOIN departments d ON doc.dept_id = d.dept_id
            GROUP BY d.dept_name
        """)
        stats = cursor.fetchall()
    conn.close()
    
    return render_template_string(HTML_TEMPLATE.replace('{% block content %}{% endblock %}', """
        <h3>医院运营统计 (报表)</h3>
        <div class="card">
            <h4>科室总收入排名</h4>
            <table>
                <tr><th>科室</th><th>总收入</th></tr>
                {% for s in stats %}
                <tr>
                    <td>{{ s.dept_name }}</td>
                    <td>￥{{ s.total }}</td>
                </tr>
                {% endfor %}
            </table>
        </div>
    """), stats=stats)

